# Copy to .env — docker compose reads it automatically.
#   cp .env.example .env
# .env is gitignored, so your PIN stays out of the repository.

# REQUIRED. LAN address of the machine running Docker — this is the address
# handed to your tablet and shown on the config page. Inside the container the
# only visible interface is the Docker bridge (172.17.x), which no tablet can
# reach, so it has to be stated here.
#   PUBLIC_HOST=192.168.2.10
#   PUBLIC_HOST=nas.local:3000     a host name works too
PUBLIC_HOST=

# Optional. Fixes the PIN for the config page and the tablet. Leave empty to
# keep whatever is in data/settings.json (a random one on first start).
# "off" disables protection entirely — only on a fully trusted network.
CONTROL_PIN=

# Optional.
TZ=Europe/Berlin
