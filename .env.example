# cp .env.example .env
# Read by docker compose and by npm start. .env is gitignored.

# Host port. If you change it, add the same port to PUBLIC_HOST.
HOST_PORT=3000

# Required for Docker: LAN address of the Docker host, shown to the tablet and
# on the config page. The container only sees the bridge address (172.17.x).
#   PUBLIC_HOST=192.168.2.10           uses HOST_PORT
#   PUBLIC_HOST=192.168.2.10:3010      with a changed port
#   PUBLIC_HOST=nas.local:3000         host names work too
PUBLIC_HOST=

# Optional. Fixed PIN for config page and tablet. Empty: keep the one in
# data/settings.json (random on first start). "off": no PIN, trusted networks only.
CONTROL_PIN=

# Optional. "on" shows the demo tournament (128 players, no GEM needed) on the
# config page. Default off.
DEMO_MODE=

# Optional.
TZ=Europe/Berlin
